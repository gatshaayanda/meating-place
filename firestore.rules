rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid))
        && get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.role
          in ['owner', 'staff'];
    }

    function isOwner() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid))
        && get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.role
          == 'owner';
    }

    match /admins/{uid} {
      allow read: if isSignedIn() && request.auth.uid == uid;
      allow create, update, delete: if false;
    }

    match /offerings/{offeringId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /specials/{specialId} {
      allow read: if resource.data.active == true || isAdmin();
      allow create, update, delete: if isAdmin();
    }

    match /homeMedia/{mediaId} {
      allow read: if resource.data.active == true || isAdmin();
      allow create, update, delete: if isAdmin();
    }

    match /bookingRequests/{requestId} {
      allow create: if
        request.resource.data.keys().hasOnly([
          'createdAt', 'name', 'phone', 'email', 'requestType',
          'date', 'startTime', 'details', 'notes', 'status'
        ])
        && request.resource.data.keys().hasAll([
          'createdAt', 'name', 'phone', 'email', 'requestType',
          'details', 'notes', 'status'
        ])
        && request.resource.data.createdAt is string
        && request.resource.data.name is string
        && request.resource.data.phone is string
        && request.resource.data.email is string
        && request.resource.data.requestType is string
        && request.resource.data.details is string
        && request.resource.data.notes is string
        && request.resource.data.status == 'New';

      allow read, update, delete: if isAdmin();
    }

    match /customers/{customerId} {
      allow read, write: if isAdmin();
    }

    match /jobs/{jobId} {
      allow read, write: if isAdmin();
    }

    match /availability/{availabilityId} {
      allow read, write: if isAdmin();
    }

    match /orders/{orderId} {
      allow read, write: if isAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
